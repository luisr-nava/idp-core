# ==================================================
# 🌐 SERVICIO: AUTH SERVICE (NestJS + PostgreSQL)
# ==================================================

# --- Aplicación ---
# Puerto interno donde corre NestJS dentro del contenedor
PORT=3000

# ==================================================
# 🗄️ BASE DE DATOS (PostgreSQL)
# ==================================================
# Host del servicio dentro de Docker (nombre del servicio en docker-compose)
DB_HOST=db

# Puerto por defecto de PostgreSQL
DB_PORT=5432

# Credenciales de conexión
DB_USER=postgres
DB_PASSWORD=postgres

# Nombre de la base de datos que se crea en el contenedor
DB_NAME=authdb

# URL completa de conexión (usada por TypeORM)
DATABASE_URL=postgres://postgres:postgres@db:5432/authdb

# ==================================================
# 🔐 JWT CONFIG
# ==================================================
# Clave secreta para firmar los tokens (no exponer en prod)
# JWT_SECRET=

# Tiempo de expiración de los tokens de acceso (ej: 15m, 1h)
JWT_ACCESS_TTL=15m

# Tiempo de expiración de los refresh tokens
JWT_REFRESH_TTL=30d

# Emisor o issuer del token (útil para validaciones cross-service)
ISSUER=http://localhost:3001

# ==================================================
# 🍪 COOKIES (opcional)
# ==================================================
# Si usás cookies HttpOnly, definir si son seguras (true en prod con HTTPS)
COOKIE_SECURE=false

# ==================================================
# 📧 SMTP (para envío de emails, opcional)
# ==================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=USER
SMTP_PASS=454545

# ==================================================
# 🧠 GOOGLE AUTH (opcional)
# ==================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_ORIGIN=
