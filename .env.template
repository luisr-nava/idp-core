# ==================================================
# 🌐 AUTH SERVICE - Variables de Entorno
# ==================================================
# Copia este archivo como .env y completa las variables

# ==================================================
# 🌐 APLICACIÓN
# ==================================================
PORT=3000
NODE_ENV=production

# ==================================================
# 🗄️ BASE DE DATOS (PostgreSQL)
# ==================================================
# Para desarrollo local con Docker, usar estos valores por defecto
# Para producción, cambiar según tu configuración de base de datos

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=authdb
DATABASE_URL=postgres://postgres:postgres@db:5432/authdb

# ==================================================
# 🔐 JWT CONFIGURATION
# ==================================================
# 🔗 Generar JWT_SECRET seguro en:
# https://randomkeygen.com/ (usar CodeIgniter Encryption Keys)
# O ejecutar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_ACCESS_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ISSUER=http://localhost:3001

# ==================================================
# 🍪 COOKIES
# ==================================================
COOKIE_SECURE=false

# ==================================================
# 📧 RESEND (Email Service)
# ==================================================
# 🔗 Resend - Servicio de envío de emails moderno y fácil de usar
# Sitio: https://resend.com/
#
# Pasos para obtener API Key:
# 1. Crear cuenta en: https://resend.com/signup
# 2. Verificar tu email
# 3. Ir a API Keys: https://resend.com/api-keys
# 4. Crear nueva API key
# 5. Copiar la API key aquí
#
# Nota: Resend permite enviar desde onboarding@resend.dev en desarrollo
# Para producción, necesitas verificar tu dominio en: https://resend.com/domains

RESEND_API_KEY=re_123456789_YourResendAPIKeyHere

# ==================================================
# 🔑 GOOGLE OAUTH 2.0
# ==================================================
# 🔗 Obtener credenciales desde Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Pasos para configurar:
# 1. Ir a: https://console.cloud.google.com/
# 2. Crear un nuevo proyecto o seleccionar uno existente
# 3. Habilitar "Google+ API" en: https://console.cloud.google.com/apis/library
# 4. Ir a Credenciales: https://console.cloud.google.com/apis/credentials
# 5. Hacer clic en "Crear credenciales" → "ID de cliente de OAuth 2.0"
# 6. Configurar pantalla de consentimiento si es necesario
# 7. Tipo de aplicación: "Aplicación web"
# 8. Agregar URIs de redireccionamiento autorizados:
#    - Desarrollo: http://localhost:3001/api/v1/auth/google/callback
#    - Producción: https://tu-dominio.com/api/v1/auth/google/callback
# 9. Copiar el Client ID y Client Secret aquí

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Para producción, cambiar a:
# GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/v1/auth/google/callback

# ==================================================
# 🔗 FRONTEND URL (Opcional)
# ==================================================
# URL del frontend para construir enlaces de recuperación de contraseña
# Si no se configura, se usará http://localhost:3000 por defecto

FRONTEND_URL=http://localhost:3000

# Para producción, cambiar a:
# FRONTEND_URL=https://tu-dominio.com
